<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Cleartext HTTP/RTSP is only used between household phones over Tailscale,
        whose WireGuard tunnel already encrypts and authenticates every packet.
    -->
    <application
        android:name=".CamNodeApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CamNode"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:launchMode="singleTop"
            android:theme="@style/Theme.CamNode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="camnode" android:host="join" />
            </intent-filter>
        </activity>

        <activity android:name=".DefaultLauncherActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:launchMode="singleTop"
            android:theme="@style/Theme.CamNode.Launch.Default"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".CalculatorLauncherActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:launchMode="singleTop"
            android:theme="@style/Theme.CamNode.Launch.Calculator"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".Calculator2LauncherActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:launchMode="singleTop"
            android:theme="@style/Theme.CamNode.Launch.Calculator2"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".Calculator3LauncherActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:launchMode="singleTop"
            android:theme="@style/Theme.CamNode.Launch.Calculator3"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ClockLauncherActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:launchMode="singleTop"
            android:theme="@style/Theme.CamNode.Launch.Clock"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".Clock2LauncherActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:launchMode="singleTop"
            android:theme="@style/Theme.CamNode.Launch.Clock2"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".Clock3LauncherActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:launchMode="singleTop"
            android:theme="@style/Theme.CamNode.Launch.Clock3"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".CalendarLauncherActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:launchMode="singleTop"
            android:theme="@style/Theme.CamNode.Launch.Calendar"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".Calendar2LauncherActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:launchMode="singleTop"
            android:theme="@style/Theme.CamNode.Launch.Calendar2"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".Calendar3LauncherActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:launchMode="singleTop"
            android:theme="@style/Theme.CamNode.Launch.Calendar3"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".NotesLauncherActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:launchMode="singleTop"
            android:theme="@style/Theme.CamNode.Launch.Notes"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".Notes2LauncherActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:launchMode="singleTop"
            android:theme="@style/Theme.CamNode.Launch.Notes2"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".Notes3LauncherActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:launchMode="singleTop"
            android:theme="@style/Theme.CamNode.Launch.Notes3"
            android:windowSoftInputMode="adjustResize" />

        <!--
            Launcher entries: the app-lock disguise enables exactly one of these
            (feature/applock LauncherDisguiser). Names must not change: launchers pin them.
            Disguise icons come from tools/make_launcher_icons.py.
        -->
        <activity-alias
            android:name=".launcher.Default"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".DefaultLauncherActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".launcher.Calculator"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_calculator"
            android:label="@string/disguise_calculator"
            android:roundIcon="@mipmap/ic_launcher_calculator_round"
            android:targetActivity=".CalculatorLauncherActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".launcher.Calculator2"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_calculator2"
            android:label="@string/disguise_calculator"
            android:roundIcon="@mipmap/ic_launcher_calculator2_round"
            android:targetActivity=".Calculator2LauncherActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".launcher.Calculator3"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_calculator3"
            android:label="@string/disguise_calculator"
            android:roundIcon="@mipmap/ic_launcher_calculator3_round"
            android:targetActivity=".Calculator3LauncherActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".launcher.Clock"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_clock"
            android:label="@string/disguise_clock"
            android:roundIcon="@mipmap/ic_launcher_clock_round"
            android:targetActivity=".ClockLauncherActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".launcher.Clock2"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_clock2"
            android:label="@string/disguise_clock"
            android:roundIcon="@mipmap/ic_launcher_clock2_round"
            android:targetActivity=".Clock2LauncherActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".launcher.Clock3"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_clock3"
            android:label="@string/disguise_clock"
            android:roundIcon="@mipmap/ic_launcher_clock3_round"
            android:targetActivity=".Clock3LauncherActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".launcher.Calendar"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_calendar"
            android:label="@string/disguise_calendar"
            android:roundIcon="@mipmap/ic_launcher_calendar_round"
            android:targetActivity=".CalendarLauncherActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".launcher.Calendar2"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_calendar2"
            android:label="@string/disguise_calendar"
            android:roundIcon="@mipmap/ic_launcher_calendar2_round"
            android:targetActivity=".Calendar2LauncherActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".launcher.Calendar3"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_calendar3"
            android:label="@string/disguise_calendar"
            android:roundIcon="@mipmap/ic_launcher_calendar3_round"
            android:targetActivity=".Calendar3LauncherActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".launcher.Notes"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_notes"
            android:label="@string/disguise_notes"
            android:roundIcon="@mipmap/ic_launcher_notes_round"
            android:targetActivity=".NotesLauncherActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".launcher.Notes2"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_notes2"
            android:label="@string/disguise_notes"
            android:roundIcon="@mipmap/ic_launcher_notes2_round"
            android:targetActivity=".Notes2LauncherActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".launcher.Notes3"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_notes3"
            android:label="@string/disguise_notes"
            android:roundIcon="@mipmap/ic_launcher_notes3_round"
            android:targetActivity=".Notes3LauncherActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>
